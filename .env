# Database
DATABASE_URL=sqlite:///./modakbul.db

# Server
PORT=8000

# Security
SECRET_KEY=project_modakbul_secret_key_123456789123456789
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Burn Rate
BASE_MINUTES=10.0
DECAY_RATE=0.90
MAX_LIFESPAN_HOURS=24
SIMILARITY_THRESHOLD=0.60

# DB Schema Limits
USERNAME_LENGTH_MAX=31
NICKNAME_LENGTH_MAX=31
TOPIC_LENGTH_MAX=127
COMMENT_LENGTH_MAX=1023

# Garbage Collection
GARBAGE_COLLECTION_INTERVAL=60

# Archiving Batch & Throttling
ARCHIVE_BATCH_SIZE=10
ARCHIVE_THROTTLE_INTERVAL=0.05